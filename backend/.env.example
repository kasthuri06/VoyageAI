# Database
DATABASE_URL=postgresql://voyageai:voyageai123@localhost:5432/voyageai

# JWT
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Maps
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
OPENROUTESERVICE_API_KEY=your-openrouteservice-api-key

# Weather (optional)
OPENWEATHER_API_KEY=your-openweather-api-key

# Groq API — AI-generated place data for any Indian city
# Free key at: https://console.groq.com
GROQ_API_KEY=your-groq-api-key
# Override the model (optional — auto-selects a working model if left empty)
# Available models: llama-3.1-8b-instant, openai/gpt-oss-20b, qwen/qwen3.8-27b
GROQ_MODEL=

# Routing preference: "algorithm" | "google" | "ors"
ROUTING_MODE=algorithm

# App
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
